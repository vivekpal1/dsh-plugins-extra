{
  "name": "dsh-terminal",
  "version": "0.1.1",
  "description": "Interactive terminal tab for DeepSeek Harness web sessions",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./output-ring": "./lib/output-ring.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "terminal",
    "pty",
    "xterm"
  ],
  "author": "Vivek Pal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vivekpal1/dsh-plugins-extra.git",
    "directory": "packages/dsh-terminal"
  },
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "node-pty": "1.1.0",
    "xterm": "5.3.0",
    "xterm-addon-fit": "0.8.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-locale": "0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "0.1.0-rc.6",
    "@deepseek-ai/dsh-subprocess": "0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "0.1.0-rc.6"
  }
}
