{
  "name": "dsh-themes",
  "version": "0.1.1",
  "description": "Cozy community color themes for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./themes": "./lib/themes.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-primitives",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-theme"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "theme",
    "catppuccin",
    "gruvbox",
    "nord",
    "tokyo-night",
    "dracula"
  ],
  "author": "Vivek Pal",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vivekpal1/dsh-plugins-extra.git",
    "directory": "dsh-themes"
  },
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-connection": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-theme": "0.1.0-rc.6",
    "react": "^18.2.0"
  }
}
